<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <h1><%= title %></h1>
    <ul>
        <% items.forEach(item => { %>
        <li><%= item _%></li>
        <% }) %>
    </ul>

    <table border="1" width="500px">
        <% users.forEach(user => { %>
        <tr>
            <td><%= user.name %></td>
            <td><%= user.age %></td>
            <td><%= user.city %></td>
        </tr>
        <% }) %>
    </table>

</body>
</html>